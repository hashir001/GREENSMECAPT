GREENSMECAPT_ENV=development
GREENSMECAPT_CONFIG=configs/default.yaml

# API and browser access
GREENSMECAPT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL connection used only by the backend
GREENSMECAPT_DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase JWT verification
GREENSMECAPT_AUTH_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
GREENSMECAPT_AUTH_AUDIENCE=authenticated
GREENSMECAPT_AUTH_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Private original-document storage
GREENSMECAPT_STORAGE_BACKEND=supabase
GREENSMECAPT_SUPABASE_URL=https://PROJECT_REF.supabase.co
GREENSMECAPT_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
GREENSMECAPT_SUPABASE_STORAGE_BUCKET=source-documents
GREENSMECAPT_FRONTEND_URL=http://localhost:5173

# Grounded language-model extraction. Keep provider keys on the backend only.
# Preferred structured OCR for scanned and table-heavy pages. Existing Paddle
# and Tesseract readers remain automatic fallbacks if the cloud call fails.
GREENSMECAPT_STRUCTURED_OCR_PROVIDER=google_document_ai
GREENSMECAPT_GOOGLE_DOCUMENT_AI_PROJECT_ID=replace-with-gcp-project-id
GREENSMECAPT_GOOGLE_DOCUMENT_AI_LOCATION=eu
GREENSMECAPT_GOOGLE_DOCUMENT_AI_OCR_PROCESSOR_ID=replace-with-ocr-processor-id
GREENSMECAPT_GOOGLE_DOCUMENT_AI_FORM_PROCESSOR_ID=replace-with-form-processor-id
# GREENSMECAPT_GOOGLE_DOCUMENT_AI_PROCESSOR_VERSION=replace-with-version-id
GREENSMECAPT_GOOGLE_DOCUMENT_AI_TIMEOUT_SECONDS=120
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Gemini semantic extraction. These three switches are sufficient when Gemini
# uses the same project and GOOGLE_APPLICATION_CREDENTIALS as Document AI.
GREENSMECAPT_SEMANTIC_PROVIDER=vertex_gemini
GREENSMECAPT_SEMANTIC_ALLOW_REMOTE=true
# Fail visibly instead of silently returning deterministic-only evidence.
GREENSMECAPT_SEMANTIC_REQUIRED=true

# Optional Vertex overrides. Defaults: Document AI project, global location,
# gemini-2.5-flash, 120 seconds, 8192 output tokens, 60 segments and 40000 chars.
# GREENSMECAPT_VERTEX_PROJECT_ID=replace-with-different-gcp-project-id
# GREENSMECAPT_VERTEX_LOCATION=global
# GREENSMECAPT_SEMANTIC_MODEL=gemini-2.5-flash
# GREENSMECAPT_SEMANTIC_TIMEOUT_SECONDS=120
# GREENSMECAPT_SEMANTIC_MAX_OUTPUT_TOKENS=8192
# GREENSMECAPT_SEMANTIC_MAX_SEGMENTS=60
# GREENSMECAPT_SEMANTIC_MAX_CHARACTERS=40000
# GREENSMECAPT_COMPANY_INTELLIGENCE_POLICY=config/company_intelligence.development.json

# Alternative hosted OpenAI-compatible provider:
# GREENSMECAPT_SEMANTIC_PROVIDER=openai_compatible
# GREENSMECAPT_SEMANTIC_ENDPOINT=https://api.openai.com/v1/chat/completions
# GREENSMECAPT_SEMANTIC_MODEL=replace-with-approved-text-model
# GREENSMECAPT_SEMANTIC_API_KEY_ENV=OPENAI_API_KEY
# GREENSMECAPT_SEMANTIC_ALLOW_REMOTE=true
# GREENSMECAPT_SEMANTIC_REQUIRED=true
# GREENSMECAPT_SEMANTIC_TOKEN_PARAMETER=max_completion_tokens
# OPENAI_API_KEY=replace-with-provider-key

# Optional chart/diagram/image-region interpretation. This may use the same
# multimodal model and key, but remains separately switchable.
GREENSMECAPT_VISUAL_ENDPOINT=https://api.openai.com/v1/chat/completions
GREENSMECAPT_VISUAL_MODEL=replace-with-approved-vision-model
GREENSMECAPT_VISUAL_API_KEY_ENV=OPENAI_API_KEY
GREENSMECAPT_VISUAL_ALLOW_REMOTE=true
GREENSMECAPT_VISUAL_TOKEN_PARAMETER=max_completion_tokens

# Local OpenAI-compatible alternative (for example Ollama or vLLM):
# GREENSMECAPT_SEMANTIC_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# GREENSMECAPT_SEMANTIC_MODEL=your-local-model
# GREENSMECAPT_SEMANTIC_API_KEY_ENV=
# GREENSMECAPT_SEMANTIC_ALLOW_REMOTE=false
