GREENSMECAPT_ENV=development
GREENSMECAPT_CONFIG=configs/default.yaml

# API and browser access
GREENSMECAPT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL connection used only by the backend
GREENSMECAPT_DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase JWT verification
GREENSMECAPT_AUTH_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
GREENSMECAPT_AUTH_AUDIENCE=authenticated
GREENSMECAPT_AUTH_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Private original-document storage
GREENSMECAPT_STORAGE_BACKEND=supabase
GREENSMECAPT_SUPABASE_URL=https://PROJECT_REF.supabase.co
GREENSMECAPT_SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
GREENSMECAPT_SUPABASE_STORAGE_BUCKET=source-documents
